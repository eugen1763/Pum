{
  "name": "pum-agent",
  "version": "0.2.18-beta.1",
  "description": "A compact terminal coding agent powered by pi and OpenTUI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugen1763/Pum.git"
  },
  "homepage": "https://github.com/eugen1763/Pum#readme",
  "bugs": {
    "url": "https://github.com/eugen1763/Pum/issues"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "terminal",
    "tui",
    "bun",
    "opentui"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "assets/tree-sitter/**",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "pum": "src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "login": "bun run src/index.tsx login",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "pack:check": "bun run scripts/validate-pack.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "typebox": "^1.3.7",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "0.3.9",
    "@microsoft/mxc-sdk": "^0.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18"
  }
}
